# Safe local default. Set another supported provider only when explicitly needed.
LLM_PROVIDER=ollama
OLLAMA_MODEL_ID=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

NOTION_TOKEN=
NOTION_PAGE_ID=
NOTION_DATABASE_ID=
NOTION_MAX_PAGES=

NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional: fixed Ollama sampling seed for reproducible evaluations
OLLAMA_SEED=

# Provider-neutral request deadline in seconds. Applied by the central LLM factory.
LLM_REQUEST_TIMEOUT=210

# End-to-end roadmap deadlines by user-selected source mode.
CORPUS_MODE_TIMEOUT=120
WEB_MODE_TIMEOUT=300
AUTO_MODE_TIMEOUT=210

# Minimum vector relevance accepted by strict corpus mode.
CORPUS_MIN_RELEVANCE=0.40

# Automatic mode: current-information requests always use web. Otherwise,
# below 0.40 use web; 0.40-0.55 use hybrid; at/above 0.55 use corpus.
AUTO_WEB_THRESHOLD=0.40
AUTO_CORPUS_THRESHOLD=0.55

# Web recovery for Web and Automatic modes: original plus compact variants.
WEB_SEARCH_MAX_ATTEMPTS=3
WEB_SEARCH_RETRY_DELAY=2.0

# Provider-neutral roadmap output cap. Increase only when the selected model supports it.
ROADMAP_MAX_OUTPUT_TOKENS=4096

# Roadmap generation policy: provider_default | disabled | enabled.
LLM_GENERATION_REASONING_MODE=disabled

# Query preprocessing: sequential (two calls) | merged (one structured call).
QUERY_PREPROCESSING_MODE=sequential

# Evaluation policy: provider_default | disabled | enabled.
# Providers without an equivalent capability keep their normal behavior.
LLM_JUDGE_REASONING_MODE=disabled

# Optional: force Hugging Face/Transformers to use locally cached models only.
# Set both to 0 if the embedding or cross-encoder model must be downloaded.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Query intent guidance. Disable only for controlled legacy comparisons.
QUERY_INTENT_ENABLED=true

# Source-preference classifier used only by Automatic mode. Explicit Corpus
# and Web selections bypass it. If disabled or inconclusive, Automatic mode
# keeps using corpus coverage and current-information routing.
INTENT_CLASSIFIER_ENABLED=true
INTENT_CONFIDENCE_MIN=0.50
EMBED_ENABLED=true
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_THRESHOLD=0.45
EMBED_MARGIN=0.03
# Keep experimental corpus-absence gating disabled: runtime retrieval already
# measures real corpus coverage and is the single source of that decision.
CRAG_MODE=0
# OOD rejector is currently diagnostic-only: it is recorded in the trace but
# cannot block or change source routing until its false positives are validated.
INTENT_REJECT_ENABLED=true
INTENT_REJECT_WEAK_THRESH=0.55
# Focused LLM judge for close semantic boundaries only. It replaces the open
# classifier call on that branch and therefore does not add a second LLM call.
INTENT_BOUNDARY_JUDGE_ENABLED=true
INTENT_JUDGE_MAX_TOKENS=160
INTENT_JUDGE_MIN_CONFIDENCE=0.50

# Retrieval and reranking policy: mmr | crossencoder | none.
RERANK_METHOD=mmr
RETRIEVAL_POOL_SIZE=10
RETRIEVAL_TOP_N=5
