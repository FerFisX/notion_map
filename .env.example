GOOGLE_API_KEY=

NOTION_TOKEN=
NOTION_PAGE_ID=
NOTION_DATABASE_ID=
NOTION_MAX_PAGES=

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Optional: fixed Ollama sampling seed for reproducible evaluations
OLLAMA_SEED=

# Provider-neutral request deadline in seconds. Applied by the central LLM factory.
LLM_REQUEST_TIMEOUT=300

# Roadmap generation policy: provider_default | disabled | enabled.
LLM_GENERATION_REASONING_MODE=disabled

# Query preprocessing: sequential (two calls) | merged (one structured call).
QUERY_PREPROCESSING_MODE=sequential

# Evaluation policy: provider_default | disabled | enabled.
# Providers without an equivalent capability keep their normal behavior.
LLM_JUDGE_REASONING_MODE=disabled
